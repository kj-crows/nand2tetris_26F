// File name: projects/3/a/PC.hdl
/**
 * A 16-bit counter.
 * if      reset(t): out(t+1) = 0
 * else if load(t):  out(t+1) = in(t)
 * else if inc(t):   out(t+1) = out(t) + 1
 * else              out(t+1) = out(t)
 */
CHIP PC {
    IN in[16],inc, load, reset;
    OUT out[16];
    
    PARTS:
    Inc16(in=holdInc, out=incOutput);
    Mux16(a=holdInc, b=incOutput, sel=inc, out=wasItInc);
    Mux16(a=wasItInc, b=in, sel=load, out=wasItLoad);
    Mux16(a=wasItLoad, b=false, sel=reset, out=wasItReset);
    Register(in=wasItReset, load=true, out=out, out=holdInc);
    
    
} 
