// File name: projects/9/Pong/PongGame.jack
/**
 * Represents a Pong game.
 * Starts with one ball; every 3 points scored adds another ball,
 * up to maxBalls balls at once.
 */
class PongGame {

    static PongGame instance; // A Pong game
    field Bat bat;            // bat
    field Array balls;        // the balls in play
    field Array lastWalls;    // last wall each ball bounced off of (parallel to balls)
    field int ballCount;      // number of balls currently in play
    field int maxBalls;       // most balls allowed at once
    field int nextBallScore;  // score at which the next ball is added
    field boolean exit;       // true when the game is over
    field int score;          // current score

    /** Constructs a new Pong game. */
    constructor PongGame new() {
        var Ball b;

        do Screen.clearScreen();
        let bat = Bat.new(224, 223);               // 57x15 bitmap: rows 223..237

        let maxBalls = 4;
        let balls = Array.new(maxBalls);
        let lastWalls = Array.new(maxBalls);

        let b = Ball.new(253, 170, 0, 511, 0, 223); // floor = top of bat; start must be above the ball's bottom limit
        do b.setDestination(400, 0);
        let balls[0] = b;
        let lastWalls[0] = 0;
        let ballCount = 1;
        let nextBallScore = 3;

        do Screen.drawRectangle(0, 238, 511, 240);
        do Output.moveCursor(22, 0);
        do Output.printString("Score: 0");

        let exit = false;
        let score = 0;

        return this;
    }

    /** Deallocates the object's memory. */
    method void dispose() {
        var int i;
        var Ball b;

        do bat.dispose();
        let i = 0;
        while (i < ballCount) {
            let b = balls[i];
            do b.dispose();
            let i = i + 1;
        }
        do balls.dispose();
        do lastWalls.dispose();
        do Memory.deAlloc(this);
        return;
    }

    /** Creates an instance of a Pong game. */
    function void newInstance() {
        let instance = PongGame.new();
        return;
    }

    /** Returns this Pong game. */
    function PongGame getInstance() {
        return instance;
    }

    /** Starts the game, and handles inputs from the user that control
     *  the bat's movement direction. */
    method void run() {
        var char key;

        while (~exit) {
            // waits for a key to be pressed.
            while ((key = 0) & (~exit)) {
                let key = Keyboard.keyPressed();
                do bat.move();
                do moveBalls();
                do Sys.wait(25);
            }

            if (key = 130) { do bat.setDirection(1); }
            else {
                if (key = 132) { do bat.setDirection(2); }
                else {
                    if (key = 140) { let exit = true; }
                }
            }

            // Waits for the key to be released.
            while ((~(key = 0)) & (~exit)) {
                let key = Keyboard.keyPressed();
                do bat.move();
                do moveBalls();
                do Sys.wait(25);
            }
        }

        if (exit) {
            do Output.moveCursor(10, 27);
            do Output.printString("Game Over");
        }

        return;
    }

    /** Moves every ball in play by one step. */
    method void moveBalls() {
        var int i;

        let i = 0;
        while (i < ballCount) {
            do moveBall(i);
            let i = i + 1;
        }
        return;
    }

    /**
     * Handles movement and bouncing for the ball at index i.
     * If the ball bounces off a wall, finds its new direction.
     * If the ball bounces off the bat, increases the score by one
     * (and adds a new ball every 3 points).
     * If any ball misses the bat, the game is over.
     */
    method void moveBall(int i) {
        var int w, bouncingDirection, batLeft, batRight, ballLeft, ballRight, ballCenter;
        var Ball b;

        let b = balls[i];
        let w = b.move();

        if ((w > 0) & (~(w = lastWalls[i]))) {
            let lastWalls[i] = w;
            let bouncingDirection = 0;
            let batLeft = bat.getLeft();
            let batRight = bat.getRight();
            let ballLeft = b.getLeft();
            let ballRight = b.getRight();
            let ballCenter = (ballLeft + ballRight) / 2;

            if (w = 4) {
                // only ever set exit to true, so one ball's hit can't cancel another's miss
                if ((batLeft > ballRight) | (batRight < ballLeft)) {
                    let exit = true;
                }
                else {
                    if (ballCenter < (batLeft + 16)) { let bouncingDirection = -1; }
                    else {
                        if (ballCenter > (batRight - 16)) { let bouncingDirection = 1; }
                    }

                    let score = score + 1;
                    do Output.moveCursor(22, 7);
                    do Output.printInt(score);

                    if ((score = nextBallScore) & (ballCount < maxBalls)) {
                        do addBall();
                        let nextBallScore = nextBallScore + 3;
                    }
                }
            }
            do b.bounce(bouncingDirection);
        }
        return;
    }

    /**
     * Adds a new ball at the top of the play area, heading down toward
     * the middle. Each new ball starts at a different x so they don't stack.
     */
    method void addBall() {
        var int x, destx;
        var Ball b;

        let x = 40 + (100 * ballCount);            // 140, 240, 340, ...
        let b = Ball.new(x, 4, 0, 511, 0, 223);    // same walls as the first ball
        if (x < 256) { let destx = x + 150; }
        else { let destx = x - 150; }
        do b.setDestination(destx, 250);

        let balls[ballCount] = b;
        let lastWalls[ballCount] = 0;
        let ballCount = ballCount + 1;
        return;
    }
}
